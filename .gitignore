# ---- Local Claude configuration and secrets (from .gitignore.append) ----
.claude/settings.local.json
.env
.env.*
!.env.example
!.env.mcp.example

# Secrets must never be committed
*.pem
*.key
!**/*.pub
secrets/
!.env.example

# ---- Go ----
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
bin/
/apps/api/bin/
/apps/api/coverage.out
/vendor/

# ---- Node / Next.js / TypeScript ----
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn/cache
.yarn/install-state.gz
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ---- Coverage / test artifacts ----
coverage/
.nyc_output/
/apps/dashboard/playwright-report/
/apps/dashboard/test-results/

# ---- Editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Logs / runtime ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/tmp/
/data/
