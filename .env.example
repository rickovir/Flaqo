# Copy to .env and fill in real values. Never commit .env.
# .env is gitignored.

# ---- Go API ----
# Listen address for the Go API server.
API_LISTEN_ADDR=:8080

# Public base URL of the API, used by the dashboard to reach it.
API_PUBLIC_URL=http://localhost:8080

# Public base URL of the dashboard, used for redirects and origin checks.
DASHBOARD_PUBLIC_URL=http://localhost:3000

# Comma-separated list of allowed dashboard origins for CORS.
ALLOWED_DASHBOARD_ORIGINS=http://localhost:3000

# ---- Database ----
# Runtime connection string. Use a dedicated least-privilege runtime role.
# This role must NOT have schema-modification privileges.
DATABASE_URL=postgres://ff_runtime:password@localhost:5432/feature_flag?sslmode=require

# Migration connection string. Use a separate role that owns the schema.
# Only needed by `make migrate-up` / integration tests, not by the running API.
MIGRATION_DATABASE_URL=postgres://ff_migrator:password@localhost:5432/feature_flag?sslmode=require

# ---- Sessions / cookies ----
# Name of the dashboard session cookie.
SESSION_COOKIE_NAME=ff_session

# Absolute session lifetime in hours.
SESSION_ABSOLUTE_TTL_HOURS=24

# Idle session timeout in hours (0 disables idle expiry).
SESSION_IDLE_TTL_HOURS=8

# Secret used to derive the CSRF token. Generate with: openssl rand -base64 32
CSRF_SECRET=replace-with-a-random-32-byte-secret

# Set to "true" in production to mark the session cookie Secure.
COOKIE_SECURE=false

# ---- Password hashing (Argon2id) ----
# Cost parameters must be calibrated for deployment hardware.
ARGON2_TIME=3
ARGON2_MEMORY_KIB=65536
ARGON2_THREADS=2
ARGON2_KEY_LENGTH=32

# ---- Initial administrator bootstrap ----
# Email and password used by the one-time `admin bootstrap` command.
# Remove after first use.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# ---- SDK key hashing ----
# Optional server-side pepper for SDK key hashing (HMAC-SHA-256).
# Store in a secret manager. Leave empty to use plain SHA-256.
SDK_KEY_PEPPER=

# ---- Rate limiting ----
# Maximum login attempts per IP per window.
LOGIN_RATE_LIMIT_MAX=5
# Rate limit window in minutes.
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ---- SSE ----
# Heartbeat interval in seconds.
SSE_HEARTBEAT_INTERVAL_SECONDS=15
# Maximum lifetime of a single SSE connection in seconds. The client reconnects.
SSE_MAX_CONNECTION_SECONDS=3600
# Bounded per-subscriber event queue size.
SSE_SUBSCRIBER_QUEUE_SIZE=16
# Maximum concurrent SSE connections per SDK credential.
SSE_MAX_CONNECTIONS_PER_KEY=10

# ---- Cache / readiness ----
# Maximum number of pooled database connections.
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_QUERY_TIMEOUT_SECONDS=5
